# MigrateBot Backend — Environment Variables
# Copy this file to .env and fill in real values before starting the server.
# Lines beginning with # are comments and are ignored.

# ── Supabase ──────────────────────────────────────────────────────────────────
# SUPABASE_URL:              Your project's REST URL (Settings → API → Project URL)
# SUPABASE_ANON_KEY:         Public anon key  — used by the frontend Supabase client
# SUPABASE_SERVICE_ROLE_KEY: Secret service-role key — used by the backend to bypass RLS
#                            Alias: SUPABASE_SERVICE_KEY is also accepted (legacy fallback
#                            in database.js) but SUPABASE_SERVICE_ROLE_KEY is preferred.
# DATABASE_URL:              Direct Postgres connection string (used for raw SQL if needed)
DATABASE_URL=postgresql://user:pass@host:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxx...
# SUPABASE_SERVICE_KEY=eyJxx...   # ← legacy alias; set this OR SUPABASE_SERVICE_ROLE_KEY, not both

# ── Redis (Railway) ───────────────────────────────────────────────────────────
# Used by Bull for the migration job queue.
# Railway provides this automatically when you add a Redis plugin.
REDIS_URL=redis://...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_xxx / whsec_test_xxx for development and staging.
# Swap to sk_live_xxx / whsec_live_xxx only after a successful test migration.
# STRIPE_PRODUCT_*_ID: find these in the Stripe dashboard under Products.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRODUCT_STANDARD_ID=prod_xxx
STRIPE_PRODUCT_PRO_ID=prod_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── GitHub ────────────────────────────────────────────────────────────────────
# GITHUB_TOKEN:          Personal access token — needs repo + workflow scopes
# GITHUB_APP_ID /
# GITHUB_PRIVATE_KEY:    Only required if using GitHub App authentication
# GITHUB_WEBHOOK_SECRET: Secret used to verify incoming GitHub webhook payloads
GITHUB_TOKEN=ghp_xxx
GITHUB_APP_ID=12345
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ── JWT & Encryption ──────────────────────────────────────────────────────────
# JWT_SECRET:      At least 32 random characters. Generate: openssl rand -base64 32
# ENCRYPTION_KEY:  64-character hex string used for AES-256 credential encryption.
#                  Generate: openssl rand -hex 32
# JWT_EXPIRES_IN:  Token lifetime — '7d' is a sensible default
JWT_SECRET=32_char_base64_string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=64_char_hex_string

# ── Frontend ──────────────────────────────────────────────────────────────────
# FRONTEND_URL: The public root URL of the frontend (no trailing slash).
# Used for CORS allowlist, Stripe portal return_url, and email deep-links.
# Production example: https://app.migratebot.io
FRONTEND_URL=http://localhost:3000

# ── SendGrid (SMTP) ───────────────────────────────────────────────────────────
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS are read by email.js.
# For SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=SG.xxx
# Domain authentication (SPF/DKIM/DMARC) must be configured in the SendGrid
# dashboard before going to production or emails will land in spam.
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@migratebot.io
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxx
SMTP_SECURE=false
EMAIL_FROM=MigrateBot <hello@migratebot.io>

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Used by the AI migration agent (agentChat.js + migrationAgent.js).
# Generate at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
