{
  "name": "migratebot",
  "version": "2.0.0",
  "description": "MigrateBot — Automated migration platform (GitHub, Replit, Emergent → Vercel + Railway + Supabase)",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "test": "jest",
    "test:backend": "cd backend && npm test",
    "deploy": "bash deploy.sh"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "jest": "^29.0.0"
  }
}
