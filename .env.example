# ============================================================
# MigrateBot — Root Environment Variables Example
# Copy to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# --- SUPABASE ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxx...
DATABASE_URL=postgresql://postgres:[password]@db.xxxx.supabase.co:5432/postgres

# --- REDIS ---
REDIS_URL=redis://default:password@host:6379

# --- STRIPE ---
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRODUCT_STANDARD_ID=prod_xxx
STRIPE_PRODUCT_PRO_ID=prod_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- GITHUB ---
GITHUB_TOKEN=ghp_xxx
GITHUB_APP_ID=12345
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# --- JWT & ENCRYPTION ---
JWT_SECRET=generate_with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=generate_with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- SENDGRID ---
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@migratebot.io

# --- ANTHROPIC (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxx...
NEXT_PUBLIC_ENV=development

# --- APP ---
# FRONTEND_URL: The public root URL of the frontend (no trailing slash).
# Used by billing.js as the return_url for the Stripe customer portal so users
# land back on /settings/billing after managing their subscription.
# Production example: https://app.migratebot.io
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=3001
